generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String    @default("")
  image         String?
  avatarColor   String    @default("0")
  createdAt     DateTime  @default(now())

  organizedEvents Event[]        @relation("Organizer")
  memberships     GroupMember[]
  responses       Response[]
  contributions   Contribution[]
  messages        Message[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  color     String
  emoji     String?
  createdAt DateTime @default(now())

  members GroupMember[]
  events  Event[]
}

model GroupMember {
  id      String @id @default(cuid())
  userId  String
  groupId String
  role    String @default("member")

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Event {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  emoji           String?
  type            String
  location        String?
  locationAddress String?
  organizerId     String
  groupId         String?
  confirmedDateId String?  @unique
  status          String   @default("open")
  createdAt       DateTime @default(now())

  organizer     User           @relation("Organizer", fields: [organizerId], references: [id])
  group         Group?         @relation(fields: [groupId], references: [id])
  proposedDates ProposedDate[]
  confirmedDate ProposedDate?  @relation("ConfirmedDate", fields: [confirmedDateId], references: [id])
  responses     Response[]
  contributions Contribution[]
  messages      Message[]
  invitations   Invitation[]
}

model ProposedDate {
  id       String   @id @default(cuid())
  eventId  String
  dateTime DateTime

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  confirmed Event?     @relation("ConfirmedDate")
  responses Response[]
}

model Response {
  id             String   @id @default(cuid())
  userId         String
  eventId        String
  proposedDateId String
  status         String
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposedDate ProposedDate @relation(fields: [proposedDateId], references: [id], onDelete: Cascade)

  @@unique([userId, proposedDateId])
}

model Invitation {
  id             String    @id @default(cuid())
  eventId        String
  email          String
  token          String    @unique
  status         String    @default("pending")
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?
  createdAt      DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Contribution {
  id      String  @id @default(cuid())
  eventId String
  userId  String
  item    String
  emoji   String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}
